# Copy to .env and fill in. Never commit .env. Use a fresh burner wallet for testnet, not your main wallet.
PRIVATE_KEY=

# Elysium testnet (Kinetiq)
RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
CHAIN_ID=99801
EXPLORER_API=https://testnet-api.elysium.kinetiq.xyz/api/

# Ascend on Elysium testnet
ASCEND_MODE=real
ASCEND_LAUNCHPAD=0x6d01f6644bbf1b5074472D3e85aa1465B4d2bF3d
ASCEND_DESK=0x06DbB5eF794BA3C0F6F0ddC6164617Cf21811a77
CL_POOL_MANAGER=0x12E84206cB53aE0df055482ebc4658635096E1aA
INFINITY_VAULT=0x2B738A9A69b7a45C9dA6B519f6bE6efBfb912aec
# Mock USDC (6 decimals, public mint) used by Ascend's test launches
QUOTE=0x84Cc00D13173f7016Bbab22A736dBf75A154cFE2

# Optional: a token you launched on Ascend's site (LaunchOnAscend just records it)
TOKEN=

# ActivateLodestar: TREASURY is required (the Team Treasury recipient); the rest are optional overrides (defaults shown)
# TREASURY=<your address>
# BURN_BPS=2000
# HOLDERS_BPS=5000
# TREASURY_BPS=3000
# MAX_SLIPPAGE_BPS=1000
# TOKEN_TO_HOLDERS=true
# ENROL_LISTING=false
# LISTING_CAP=<in the quote's units; required when ENROL_LISTING=true>
# LOCK_FOREVER=true

# DeployCore: who owns the factory (names the upgrade successor and the default swapper). On a live chain
# this must be a multisig, separate from every steward; on the testnet the deployer keeps it if unset.
# FACTORY_OWNER=

# ------------------------------- Elysium mainnet: Ascend v5, Volta, Montra, ElysPump, Boxa and Kleos
# Deployed with DeployLaunchpads then (12 hours later) FinishLaunchpads; recorded in
# deployments/launchpads/99901.json. See docs/launchpads.md.
# RPC_URL=<an Elysium mainnet RPC (chain 99901); before November 9 a launchpad's relaying RPC such as https://rpc.eleos.fun>
# FACTORY_OWNER=<the Safe that owns the factories, the adapters and Exile; required, and must be a contract>
#
# ActivateLaunchpad, run by the coin's creator:
# LAUNCHPAD=volta            # ascend, volta, montra, elyspump, boxa or kleos
# TOKEN=<the coin>
# TREASURY=<Team Treasury recipient, permanent>
# SWAPPER=                   # unset = the factory default (none in phase 1); v4 = the V4Swapper for the coin's pool
# CLAIM_FIRST=true           # Montra only: pay the creator what the hook holds for the pool before the role moves
# TREASURY_WINDOW=604800     # seconds the Team Treasury share streams over
# BURN_BPS / HOLDERS_BPS / TREASURY_BPS / MAX_SLIPPAGE_BPS / TOKEN_TO_HOLDERS / LOCK_FOREVER as above
#
# tools/keeper-launchpads.sh: KEEPER_PRIVATE_KEY (a gas-only wallet), RPC_URL, optional MAX_GAS (default 4000000),
#   MIN_ROUTE_WEI (default 1e15, 0.001 HYPE), MIN_ROUTE_TOKENS (default 1e18) and MIN_HARVEST_WEI (default 1e13);
#   in the workflow these come from the MAINNET_MIN_* repository variables
# tools/rehearse-launchpads.sh: ELYSIUM_RPC_URL; runs everything on a local anvil fork, sends nothing
